# Ignore all .log files
*.log

# Ignore a specific file
my_secret_key.pem

# Ignore a specific directory and its contents
build/

# Ignore all files with a .tmp extension in any directory
**/*.tmp

# Ignore the 'vendor' directory in the root of the repository
/vendor/

# Ignore the 'node_modules' directory and its contents, commonly used in Node.js projects
node_modules/

# Ignore files generated by operating systems or IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep a specific file within an ignored directory
# First, ignore the 'logs' directory
logs/
# Then, un-ignore a specific file within it
!logs/important.log

# Ignore all files in the 'cache' directory, but not the directory itself
cache/*
